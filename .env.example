# Copy to .env.local for local development. Never commit .env.local.

# --- Local secrets (generated automatically on first setup if missing) ---
ENV_VAULT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- AI (OpenAI-compatible). Without AI_API_KEY the lab shows Needs configuration. ---
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-2-latest

# --- Web3 (public) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- GitHub OAuth (server only) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- IPFS pinning ---
IPFS_JWT=
WEB3_STORAGE_TOKEN=

# --- Vercel deploy ---
VERCEL_TOKEN=

# --- Optional ---
DATABASE_URL=
AKIRO_PROJECT_ROOT=/workspace/akiro-projects/default
